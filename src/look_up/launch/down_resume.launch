<?xml version="1.0" encoding="UTF-8"?>
<!-- ===================================================================
  down_resume.launch - 主启动文件
  一键启动所有仿真节点（原 1.sh 的 docker/tmux 版本改为标准 ROS launch）
  用法: roslaunch down_resume.launch
  (将此文件放在工作区根目录或任意 launch 目录下)
==================================================================== -->

<launch>
    <!-- ========== 全局参数 ========== -->
    <arg name="num_drones" default="6" />
    <arg name="mission_filename" default="mission_down.json" />
    <arg name="navigation_mode" default="static_patrol" />
    <arg name="goal_source" default="mission" />
    <arg name="ego_dir" default="/home/wangtao/robocup_fly/external/ego-planner-swarm" />
    <arg name="_validated_mode"
         value="$(eval navigation_mode if navigation_mode in ['ego', 'static_patrol'] else int('navigation_mode is not implemented in the single-drone EGO phase'))" />
    <arg name="_validated_goal_source"
         value="$(eval goal_source if goal_source in ['mission', 'manual'] else int('goal_source must be mission or manual'))" />
    <arg name="active_num_drones"
         value="$(eval 1 if navigation_mode == 'ego' else int(num_drones))" />

    <!-- ========== 1. 定位 ========== -->
    <include file="$(find pose_init)/launch/pose.launch" />

    <!-- ========== 2. 云台控制 (非roslaunch脚本，需单独处理) ========== -->
    <!-- 原始命令: cd $HOME/ZZU_FLY/src/gimbal && bash multi_gimbal_control.sh -->
    <!-- 如已封装为 ROS 节点，取消下方注释 -->
    <!-- <node name="gimbal_control" pkg="gimbal" type="multi_gimbal_control.sh" output="screen" /> -->

    <!-- ========== 3. 静态变换 ========== -->
    <include file="$(find simple_navigator)/launch/static_tf.launch" />
    <include file="$(find competition_compliance)/launch/sensor_tf.launch" />

    <!-- ========== 4. TF 变换树 ========== -->
    <include file="$(find transform_tree)/launch/tf.launch">
        <arg name="num_drones" value="$(arg active_num_drones)" />
    </include>

    <!-- ========== 5. 目标管理 ========== -->
    <include file="$(find look_up)/launch/target_lookup_service.launch" />

    <!-- ========== 6. 最终速度安全过滤 ========== -->
    <include file="$(find safety_filter)/launch/safety_filter_swarm.launch">
        <arg name="num_drones" value="$(arg active_num_drones)" />
        <arg name="perception_guard_enabled"
             value="$(eval navigation_mode == 'ego')" />
    </include>

    <!-- ========== 7. 总控节点 ========== -->
    <include file="$(find look_up)/launch/spawn_mux_swarm.launch">
        <arg name="num_drones" value="$(arg active_num_drones)" />
    </include>

    <!-- ========== 8. 起飞命令 ========== -->
    <include file="$(find fly)/launch/fly.launch">
        <arg name="drone_quantity" value="$(arg active_num_drones)" />
    </include>

    <!-- ========== 9. 导航 ========== -->
    <group if="$(eval navigation_mode == 'ego')">
        <include file="$(find look_up)/launch/navigation_single.launch">
            <arg name="navigation_mode" value="ego" />
            <arg name="ego_dir" value="$(arg ego_dir)" />
        </include>
    </group>
    <group if="$(eval navigation_mode == 'static_patrol')">
        <include file="$(find simple_navigator)/launch/nav.launch">
            <arg name="num_drones" value="$(arg active_num_drones)" />
        </include>
    </group>

    <!-- ========== 10. 定点巡航 ========== -->
    <include file="$(find task_manager)/launch/task.launch"
             if="$(eval goal_source == 'mission')">
        <arg name="num_drones" value="$(arg active_num_drones)" />
        <arg name="mission_filename" value="$(arg mission_filename)" />
    </include>

    <!-- ========== 11. 检测节点 (非roslaunch脚本，需单独处理) ========== -->
    <!-- 原始命令: cd $HOME/ZZU_FLY/src/yolo && bash multi_yolo_detecting.sh -->
    <!-- 如已封装为 ROS 节点，取消下方注释 -->
    <!-- <node name="yolo_detecting" pkg="yolo" type="multi_yolo_detecting.sh" output="screen" /> -->

    <!-- ========== 12. 追踪节点 ========== -->
    <include file="$(find tracking)/launch/tracking.launch">
        <arg name="num_drones" value="$(arg active_num_drones)" />
    </include>

    <!-- ========== 13. 坐标计算节点 (非roslaunch脚本，需单独处理) ========== -->
    <!-- 原始命令: cd $HOME/ZZU_FLY/src/yolo && bash multi_solving.sh -->
    <!-- 如已封装为 ROS 节点，取消下方注释 -->
    <!-- <node name="yolo_solving" pkg="yolo" type="multi_solving.sh" output="screen" /> -->

</launch>
