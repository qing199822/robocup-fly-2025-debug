<?xml version="1.0"?>
<package format="2">
  <name>ego_adapter</name>
  <version>0.1.0</version>
  <description>Fail-closed team adapter for external EGO planner output.</description>
  <maintainer email="qing199822@users.noreply.github.com">ZZU FLY Team</maintainer>
  <license>LicenseRef-Team-Code</license>

  <buildtool_depend>catkin</buildtool_depend>

