<?xml version="1.0"?>
<launch>
  <param name="/use_sim_time" value="true"/>

  <node pkg="local_mapping" type="local_mapping_node"
        name="local_mapping_clock_rollback_under_test"
        required="true" output="screen">
    <param name="depth_topic" value="/rollback/depth"/>
    <param name="camera_info_topic" value="/rollback/camera_info"/>
    <param name="odom_topic" value="/rollback/odom"/>
    <param name="bounding_boxes_topic" value="/rollback/boxes"/>
    <param name="planner_depth_topic" value="/rollback/planner_depth"/>
    <param name="static_cloud_topic" value="/rollback/static_cloud"/>
    <param name="dynamic_cloud_topic" value="/rollback/dynamic_cloud"/>
    <param name="health_topic" value="/rollback/health"/>
    <param name="clearance_topic" value="/rollback/clearance"/>
    <param name="frontier_goal_topic" value="/rollback/frontier_goal"/>

    <param name="max_sync_delta" value="0.15"/>
    <param name="depth_timeout" value="0.35"/>
    <param name="odom_timeout" value="0.35"/>
    <param name="recovery_window" value="0.20"/>
    <param name="min_valid_depth_ratio" value="0.20"/>
    <param name="depth_min_m" value="0.20"/>
    <param name="depth_max_m" value="8.00"/>
    <param name="pixel_stride" value="4"/>
    <param name="mask_margin_pixels" value="0"/>
    <param name="voxel_resolution" value="0.20"/>
    <param name="occupied_hits" value="1"/>
    <param name="free_hits" value="1"/>
    <param name="dynamic_ttl" value="0.30"/>
    <param name="publish_rate" value="20.0"/>
    <param name="search_altitude" value="3.0"/>
    <param name="max_frontier_distance" value="2.0"/>
    <param name="frontier_resolution" value="0.25"/>
    <param name="vehicle_vertical_radius" value="0.20"/>
    <param name="min_frontier_cluster_cells" value="2"/>
    <param name="max_clearance_distance" value="2.0"/>
    <param name="base_frame" value="base_link"/>
    <param name="camera_frame" value="rollback_camera"/>
    <param name="tf_timeout" value="0.05"/>
  </node>

  <test test-name="local_mapping_clock_rollback_test" pkg="local_mapping"
        type="test_local_mapping_clock_rollback.py" time-limit="25"/>
</launch>
