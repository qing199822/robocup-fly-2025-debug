<?xml version="1.0"?>
<launch>
  <arg name="vehicle_type" default="typhoon_h480"/>
  <arg name="drone_id" default="0"/>

  <arg name="depth_topic"
       default="/typhoon_h480_0/realsense/depth_camera/depth/image_raw"/>
  <arg name="camera_info_topic"
       default="/typhoon_h480_0/realsense/depth_camera/depth/camera_info"/>
  <arg name="odom_topic" default="/typhoon_h480_0/global_odom"/>
  <arg name="bounding_boxes_topic"
       default="/typhoon_h480_0/yolo11n/bounding_boxes"/>

  <node pkg="local_mapping" type="local_mapping_node"
        name="$(eval 'local_mapping_typhoon_h480_0' if arg('vehicle_type') == 'typhoon_h480' and str(arg('drone_id')) == '0' else int('local_mapping_single.launch supports only vehicle_type:=typhoon_h480 drone_id:=0'))"
        required="true" output="screen">
    <rosparam command="load"
              file="$(find local_mapping)/config/single_drone.yaml"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="bounding_boxes_topic" value="$(arg bounding_boxes_topic)"/>
  </node>
</launch>
